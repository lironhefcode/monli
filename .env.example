# Copy to .env before running `docker compose up`.

# Required.
POSTGRES_PASSWORD=password
# Signs UI session cookies and encrypts saved notification secrets (webhook
# URLs, SMTP password); changing it means entering those again. At least 32
# random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional — defaults shown.
# POSTGRES_USER=username
# POSTGRES_DB=database
# POSTGRES_PORT=5432

# Port nginx listens on for the UI, the API, and agents.
# HTTP_PORT=8080

# URL agents and the install command use to reach the API. Must be reachable
# from the monitored hosts, so on a real deployment this is your public
# hostname, not localhost. Include the /api prefix — nginx strips it.
# PUBLIC_API_URL=http://localhost:8080/api

# Extra browser origins allowed to sign in to the UI, comma-separated. Only
# needed when admins open the UI on a different address than PUBLIC_API_URL.
# AUTH_TRUSTED_ORIGINS=http://monli.internal:8080

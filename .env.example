# Copy to .env before running `docker compose up`.

# Required. This is the only value without a default.
POSTGRES_PASSWORD=password

# Optional — defaults shown.
# POSTGRES_USER=username
# POSTGRES_DB=database
# POSTGRES_PORT=5432

# Port nginx listens on for the API and agents.
# HTTP_PORT=8080

# URL agents and the install command use to reach the API. Must be reachable
# from the monitored hosts, so on a real deployment this is your public
# hostname, not localhost.
# PUBLIC_API_URL=http://localhost:8080
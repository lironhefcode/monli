PORT=3000
DATABASE_URL="postgresql://monli:monli@localhost:5432/monli"
PUBLIC_API_URL="http://localhost:3000"
# Reverse proxies whose X-Forwarded-For to trust: comma-separated IPs/CIDRs,
# or the presets "loopback", "linklocal", "uniquelocal". Leave unset if the
# API is reached directly.
# TRUST_PROXY="loopback"
# Signs session cookies (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Browser origins allowed to sign in besides PUBLIC_API_URL's, comma-separated.
# The frontend dev server runs on :3001.
AUTH_TRUSTED_ORIGINS="http://localhost:3001"

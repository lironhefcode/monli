generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catalog: reusable metric definitions
model Metric {
  id          Int     @id @default(autoincrement())
  metricKey   String  @unique @map("metric_key")
  unit        String?
  description String?

  // Suggested policy, pre-filled when the metric is added to a template.
  defaultCondition         String? @map("default_condition")
  defaultWarningThreshold  Float?  @map("default_warning_threshold")
  defaultCriticalThreshold Float?  @map("default_critical_threshold")
  defaultPriority          String? @map("default_priority")
  defaultReportIntervalSec Int?    @map("default_report_interval_sec")
  defaultAlertSubject      String? @map("default_alert_subject")
  // Set for metrics measured per device ("filesystem", "disk" or "network"):
  // each reading names its interface, and alerts open per interface. Null for
  // host-wide metrics.
  deviceKind               String? @map("device_kind")

  templateMetrics TemplateMetric[]
  overrides       TargetMetricOverride[]
  readings        MetricReading[]
  alerts          Alert[]

  @@map("metrics")
}

// Templates: pure organizational bundles for mass-applying metrics
model Template {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  templateMetrics TemplateMetric[]
  targetTemplates TargetTemplate[]

  @@map("templates")
}

// Join table: metrics in a template + that template's suggested defaults
model TemplateMetric {
  id                  Int     @id @default(autoincrement())
  templateId          Int     @map("template_id")
  metricId            Int     @map("metric_id")
  reportIntervalSec   Int     @default(60) @map("report_interval_sec")
  // One condition, two levels; a null threshold turns that level off (both
  // null: monitor only, no alerts).
  condition           String
  warningThreshold    Float?  @map("warning_threshold")
  criticalThreshold   Float?  @map("critical_threshold")
  consecutiveBreaches Int     @default(1) @map("consecutive_breaches")
  responsibleTeam     String? @map("responsible_team")
  alertSubject        String  @default("") @map("alert_subject")
  alertDescription    String? @map("alert_description")
  priority            String  @default("p3")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metric   Metric   @relation(fields: [metricId], references: [id])

  @@unique([templateId, metricId])
  @@map("template_metrics")
}

// Targets: monitored hosts/services
model Target {
  id              Int       @id @default(autoincrement())
  // Hostname reported by the agent; enrollment matches on it, so it never changes.
  name            String
  // Optional display name shown instead of name.
  alias           String?
  type            String
  ipAddress       String?   @map("ip_address")
  os              String?
  arch            String?
  // e.g. "Ubuntu 22.04 (WSL)", from the agent; os stays the OS family.
  distro          String?
  description     String?
  responsibleTeam String?   @map("responsible_team")
  status          String    @default("unknown")
  lastSeenAt      DateTime? @map("last_seen_at")
  apiKeyHash      String    @map("api_key_hash")
  createdAt       DateTime  @default(now()) @map("created_at")

  targetTemplates  TargetTemplate[]
  overrides        TargetMetricOverride[]
  readings         MetricReading[]
  alerts           Alert[]
  enrollmentTokens EnrollmentToken[]
  interfaces       TargetInterface[]

  @@map("targets")
}

// A device on a target that per-device metrics are measured on: a mounted
// filesystem, a physical disk or a NIC. Created the first time the agent
// reports a reading for it; kept (with its history) after it stops reporting.
model TargetInterface {
  id          Int      @id @default(autoincrement())
  targetId    Int      @map("target_id")
  // Matches Metric.deviceKind: "filesystem", "disk" or "network".
  kind        String
  // Mount point, disk or NIC name, as the agent reports it.
  name        String
  // Off: readings for it are ignored, so it is neither stored nor alerted on.
  monitored   Boolean  @default(true)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  target   Target          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  readings MetricReading[]
  alerts   Alert[]

  @@unique([targetId, kind, name])
  @@map("target_interfaces")
}

// Single-use, short-lived token handed out with the agent install command.
// The agent exchanges it for a target-bound API key on first check-in.
model EnrollmentToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  targetId  Int?      @map("target_id")
  createdAt DateTime  @default(now()) @map("created_at")

  target Target? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@map("enrollment_tokens")
}

// Which templates a target pulls metrics from (many-to-many)
model TargetTemplate {
  id         Int @id @default(autoincrement())
  targetId   Int @map("target_id")
  templateId Int @map("template_id")

  target   Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([targetId, templateId])
  @@map("target_templates")
}

// Per-(target, metric) customization, template-agnostic: a full copy of the
// policy that replaces the template's (template edits don't reach it). Null
// thresholds turn that level off; a null team falls back to the target's team.
// App-layer rule: metric_id must already be reachable via one of the
// target's assigned templates before an override can be created.
model TargetMetricOverride {
  id                  Int     @id @default(autoincrement())
  targetId            Int     @map("target_id")
  metricId            Int     @map("metric_id")
  reportIntervalSec   Int     @map("report_interval_sec")
  condition           String
  warningThreshold    Float?  @map("warning_threshold")
  criticalThreshold   Float?  @map("critical_threshold")
  consecutiveBreaches Int     @map("consecutive_breaches")
  responsibleTeam     String? @map("responsible_team")
  alertSubject        String  @default("") @map("alert_subject")
  alertDescription    String? @map("alert_description")
  priority            String

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([targetId, metricId])
  @@map("target_metric_overrides")
}

// Time-series data
model MetricReading {
  id          BigInt   @id @default(autoincrement())
  targetId    Int      @map("target_id")
  metricId    Int      @map("metric_id")
  // Set exactly when the metric is per-device.
  interfaceId Int?     @map("interface_id")
  value       Float
  recordedAt  DateTime @default(now()) @map("recorded_at")

  target    Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  metric    Metric           @relation(fields: [metricId], references: [id])
  interface TargetInterface? @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@index([targetId, metricId, interfaceId, recordedAt(sort: Desc)], name: "idx_readings_target_metric_time")
  @@map("metric_readings")
}

// Alerts: snapshot of resolved policy + response metadata at breach time
model Alert {
  id              Int       @id @default(autoincrement())
  targetId        Int       @map("target_id")
  metricId        Int       @map("metric_id")
  // One alert per (target, metric, interface); null for host-wide metrics.
  interfaceId     Int?      @map("interface_id")
  triggeredValue  Float     @map("triggered_value")
  // Latest reading while open; severity follows the latest reading's level.
  lastValue       Float?    @map("last_value")
  lastValueAt     DateTime? @map("last_value_at")
  severity        String
  status          String    @default("open")
  openedAt        DateTime  @default(now()) @map("opened_at")
  resolvedAt      DateTime? @map("resolved_at")
  responsibleTeam String?   @map("responsible_team")
  // Target's display name (alias or name) when the alert opened.
  hostName        String    @map("host_name")
  subject         String
  description     String?
  priority        String
  // Can be undone; each change is recorded in comments.
  acknowledged    Boolean   @default(false)

  target    Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  metric    Metric           @relation(fields: [metricId], references: [id])
  interface TargetInterface? @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  comments  AlertComment[]

  @@index([status], name: "idx_alerts_status")
  @@index([targetId], name: "idx_alerts_target")
  @@map("alerts")
}

// Timed history of ack, unack and manual resolve on an alert, each with an optional note.
model AlertComment {
  id        Int      @id @default(autoincrement())
  alertId   Int      @map("alert_id")
  action    String // 'ack' | 'unack' | 'resolve'
  body      String?
  // Name of the signed-in user who acted, kept as text (null on older rows).
  author    String?
  createdAt DateTime @default(now()) @map("created_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt], name: "idx_alert_comments_alert")
  @@map("alert_comments")
}

// Where alert notifications go: a chat or HTTP webhook, or a set of email
// recipients. Saved once and picked by any number of rules.
model NotificationDestination {
  id              Int       @id @default(autoincrement())
  name            String
  // "discord", "slack", "generic" (plain JSON) or "email".
  kind            String
  // Webhook kinds only, encrypted (see utils/secret-box.ts): Discord and Slack
  // URLs embed a secret token.
  url             String?
  // Email only: addresses that aren't Monli users.
  emailAddresses  String[]  @default([]) @map("email_addresses")
  // Outcome of the latest delivery; lastStatus is null when no HTTP response came.
  lastDeliveredAt DateTime? @map("last_delivered_at")
  lastStatus      Int?      @map("last_status")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  recipients DestinationRecipient[]
  rules      NotificationRuleDestination[]

  @@map("notification_destinations")
}

// Users an email destination sends to, at their current address.
model DestinationRecipient {
  destinationId Int    @map("destination_id")
  userId        String @map("user_id")

  destination NotificationDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([destinationId, userId])
  @@map("destination_recipients")
}

// Which alerts are sent where: alerts of any of teams (empty: every team) at
// minPriority or higher (null: any) go to each of the rule's destinations.
model NotificationRule {
  id          Int      @id @default(autoincrement())
  name        String
  teams       String[] @default([])
  // p1 is highest.
  minPriority String?  @map("min_priority")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  destinations NotificationRuleDestination[]

  @@map("notification_rules")
}

model NotificationRuleDestination {
  ruleId        Int @map("rule_id")
  destinationId Int @map("destination_id")

  rule        NotificationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  destination NotificationDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([ruleId, destinationId])
  @@map("notification_rule_destinations")
}

// SMTP server email destinations send through; a single row (id 1), absent
// until an admin sets it up.
model EmailServer {
  id          Int      @id @default(1)
  host        String
  port        Int
  // "tls" (implicit, usually 465), "starttls" (usually 587) or "none".
  security    String
  username    String?
  // Encrypted (see utils/secret-box.ts).
  password    String?
  // e.g. Monli <alerts@example.com>
  fromAddress String   @map("from_address")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_server")
}

// ── Auth (Better Auth). Field names are Better Auth's; ids are generated by it.

// A person who signs in to the UI. role is viewer, editor or admin (admin plugin).
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  sessions              Session[]
  accounts              Account[]
  destinationRecipients DestinationRecipient[]

  @@map("users")
}

// A signed-in browser; the session cookie holds token.
model Session {
  id             String   @id
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A way to sign in; for email login (providerId "credential") it holds the
// password hash.
model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens (e.g. password reset); unused until those flows exist.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
